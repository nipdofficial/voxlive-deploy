# FastAPI server
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
APP_NAME=HelaScribe API
API_PREFIX=/api
ALLOWED_ORIGINS=*

# Existing Google Cloud Vertex AI service-account JSON
VERTEX_SERVICE_ACCOUNT_JSON=./service_account.json
GCP_PROJECT=moj-transcription-project
GCP_LOCATION=global

# Gemini model IDs
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
GEMINI_BATCH_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash
AUTO_TRANSLATE=true
TARGET_LANGUAGE=Tamil
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_SECONDS=1.0
GEMINI_LIVE_TIMEOUT_SECONDS=30.0
GEMINI_BATCH_TIMEOUT_SECONDS=90.0
LIVE_CHUNK_SECONDS=1.0
LIVE_CHUNK_OVERLAP_SECONDS=0.25
LIVE_STOP_PREVIEW_GRACE_SECONDS=3.0
LIVE_PREVIEW_QUEUE_SIZE=8
LIVE_SILENCE_RMS_THRESHOLD=200
LIVE_FINALIZE_FULL_AUDIO=true
MAX_LIVE_MINUTES=120
MAX_UPLOAD_MB=20

# Optional multi-user Meeting mode (LiveKit Cloud)
LIVEKIT_URL=wss://replace-me.livekit.cloud
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me
LIVEKIT_TOKEN_MINUTES=120

# Hugging Face / pyannote
HUGGINGFACE_TOKEN=hf_replace_me
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1

# Local persistence
DATA_DIR=./data

# Optional production error monitoring
SENTRY_DSN=
APP_ENVIRONMENT=development

# Role-based sign-in. The admin signs in with these credentials to open the
# admin dashboard; this email cannot be registered as a normal user.
ADMIN_EMAIL=admin@voxlive.local
ADMIN_PASSWORD=change_me_to_a_strong_password
AUTH_SESSION_HOURS=24
